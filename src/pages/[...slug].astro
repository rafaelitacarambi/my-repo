---
import { ClerkProvider } from "@clerk/astro/components";
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
// import "@wix/wix-vibe-plugins/plugins-vars.css"; // Likely not needed or can be mocked if styles are essential
// import "@wix/wix-vibe-plugins/plugins-theme.css";
import "@/styles/global.css";

// SEO Tags service requires backend connection, skipping for local dev
const seoTagsServiceConfig = {
    title: "Local Dev Preview",
    metaTags: []
};
---

<ClerkProvider>
  <html lang="en" class="w-full h-full">
    <head>
      <Head />
      <!-- SEO tags disabled for local dev -->
    </head>
    <body class="w-full h-full">
      <div id="root" class="w-full h-full">
        <AppRouter client:only="react" />
      </div>
    </body>
  </html>
</ClerkProvider>
