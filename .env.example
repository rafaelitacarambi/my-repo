# Banco de desenvolvimento (não use produção para testes de escrita)
DATABASE_URL=

# Clerk: chaves da instância de desenvolvimento
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Envio de e-mail (opcional; sem chave o serviço existente simula envio)
RESEND_API_KEY=

# WhatsApp Cloud API Credentials
# Obtidos em developers.facebook.com > WhatsApp > Configuração da API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# Token que você define para validar o webhook na Meta
WHATSAPP_VERIFY_TOKEN=

# Assinaturas de eventos recebidos (obrigatórias para ativar webhooks)
CLERK_WEBHOOK_SIGNING_SECRET=
WHATSAPP_APP_SECRET=

# Simulação de assinatura: só funciona em astro dev; nunca em build/produção
SIGNATURE_SIMULATION_ENABLED=false
