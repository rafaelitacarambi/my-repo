generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------------
// 1. Usuários do Sistema (Equipe Administradora e Corretores)
// -------------------------------------------------------------------------
model User {
  id      String  @id @default(uuid())
  clerkId String? @unique // Integração futura com o Clerk
  name    String
  email   String  @unique
  role    String  @default("USER") // ADMIN, MANAGER, BROKER, etc.
  status  String  @default("ACTIVE") // ACTIVE, INACTIVE
  setores String[] @default([])
  unidadeRef String?
  memberRef  String?
  ativo      Boolean @default(true)
  lastLogin  DateTime?

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 2. Clientes (Locatários, Proprietários, Fiadores, Leads)
// -------------------------------------------------------------------------
model Client {
  id       String  @id @default(uuid())
  name     String
  email    String?
  phone    String?
  document String? @unique // CPF ou CNPJ
  type     String  @default("LEAD") // LEAD, TENANT, OWNER, GUARANTOR
  address  String?
  rg       String?
  nationality   String?
  maritalStatus String?
  profession    String?

  status   String? @default("Ativo")
  papeis   String?
  notes    String? @db.Text
  gender   String?

  // Novos campos para origem do cliente
  canalOrigem           String?
  responsavelInternoId  String?

  // Relacionamentos para Contratos e Imóveis
  ownedProperties   Property[] @relation("PropertyOwner")
  contractsAsTenant Contract[] @relation("ContractTenant")
  leads            Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 2.1 Leads de Contato (Interesses e Perfil)
// -------------------------------------------------------------------------
model Lead {
  id                 String   @id @default(uuid())
  clientRef          String
  client             Client   @relation(fields: [clientRef], references: [id])
  
  fullName           String
  email              String?
  phoneNumber        String?
  
  interessePrincipal String   // Compra, Locação, etc.
  tipoImovelDesejado String?
  cidadeDesejada     String?
  bairroDesejado     String?
  faixaValorMin      Float?
  faixaValorMax      Float?
  potencialEntrada   Float?
  rendaBruta         Float?
  perfilCompra       String?
  urgencia           String?
  
  leadStatus         String   @default("Novo")
  statusFunil        String   @default("Novo")
  leadSource         String   @default("Área Restrita")
  
  submissionDate     DateTime @default(now())
  ultimaInteracao    DateTime @default(now())
  
  responsavelRef     String?  // ID do Corretor
  unidadeRef         String?  // ID da Unidade
  
  generatedContracts GeneratedContract[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 3. Imóveis (Vitrine e Locação)
// -------------------------------------------------------------------------
model Property {
  id     String @id @default(uuid())
  code   String @unique // Ex: CA0149
  title  String // Ex: Casa em Suzano
  type   String // Ex: Casa, Apartamento, Terreno
  finalidade    String? // Ex: Residencial, Comercial
  pretensao     String? // Venda, Locacao, Venda e Locacao
  status        String  @default("AVAILABLE") // AVAILABLE, RENTED, SOLD
  situacaoImovel String? // Desocupado, Ocupado, Reservado, Em construção
  midiaOrigem   String? // Captacao, Indicacao, Portal, Proprietario

  // Valores
  salePrice             Float?
  rentPrice             Float?
  condoPrice            Float?
  iptuPrice             Float?
  periodicidadeIPTU     String? // Mensal, Anual
  entradaMinimaEstimada Float?
  pacoteLocacao         Float?

  // Flags financeiras
  aceitaFinanciamento      Boolean @default(false)
  aceitaFgts               Boolean @default(false)
  imovelCondominio         Boolean @default(false)
  investimentoOportunidade Boolean @default(false)
  permiteFinanciamento     Boolean @default(true)

  // Características
  description String?  @db.Text
  mainImage   String?
  images      String[]
  areaTotal Float?
  areaUtil  Float?
  bedrooms  Int?
  suites    Int?
  bathrooms Int?
  garages   Int?

  // Amenidades (checkboxes)
  amenidades Json? // { churrasqueira: true, piscina: true, ... }

  // Localização
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?

  // Proprietário
  nomeProprietario     String?
  telefoneProprietario String?
  emailProprietario    String?

  ownerId String?
  owner   Client? @relation("PropertyOwner", fields: [ownerId], references: [id])

  contracts Contract[]
  generatedContracts GeneratedContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 4. Contratos de Locação / Vendas
// -------------------------------------------------------------------------
model Contract {
  id     String @id @default(uuid())
  type   String @default("RENT") // RENT, SALE
  status String @default("ACTIVE") // ACTIVE, FINISHED, CANCELED

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  tenantId String
  tenant   Client @relation("ContractTenant", fields: [tenantId], references: [id])

  startDate DateTime
  endDate   DateTime?
  rentValue Float
  guarantee String? // CAUCAO, FIADOR, SEGURO

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 5. Cobranças e Faturas (Mensalidades / Boletos / PJBank)
// -------------------------------------------------------------------------
model Invoice {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  amount  Float
  dueDate DateTime
  status  String   @default("PENDING") // PENDING, PAID, LATE, CANCELED

  // Dados do Gateway de Pagamento (PJBank)
  gatewayId   String? // ID do boleto gerado no PJBank
  bankSlipUrl String? // Link do boleto
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 6. Log de Auditoria
// -------------------------------------------------------------------------
model AuditLog {
  id     String  @id @default(uuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  action     String // CREATE_PROPERTY, UPDATE_CONTRACT, DELETE_USER
  entityType String // Model q sofreu a alteração
  entityId   String // ID do registro alterado
  details    String? // JSON com os dados "antes e depois"

  createdAt DateTime @default(now())
}

// -------------------------------------------------------------------------
// 7. Log de E-mails Transacionais (Disparos API)
// -------------------------------------------------------------------------
model EmailLog {
  id         String   @id @default(uuid())
  to         String
  subject    String
  status     String   @default("PENDING") // PENDING, SENT, FAILED
  resendId   String?  // ID de transação retornado pela API do Resend
  errorMsg   String?  // Motivo do bloqueio / falha

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 8. Templates de Contrato (Gerador de Contratos)
// -------------------------------------------------------------------------
model ContractTemplate {
  id                  String   @id @default(uuid())
  nome                String
  categoria           String   // LOCACAO, VENDA, OUTROS
  tipoOperacao        String?  // Ex: "Locacao", "Compra e Venda"
  subtipo             String?  // Ex: "Com Fiador", "A Vista"
  garantia            String?  // Ex: "SEGURO", "FIADOR", "CAUCAO"
  conteudoHtml        String   @db.Text
  variaveisDetectadas String[] @default([])
  ativo               Boolean  @default(true)
  versao              Int      @default(1)
  
  contratosGerados    GeneratedContract[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// -------------------------------------------------------------------------
// 9. Contratos Gerados (Atendimentos / Kanban)
// -------------------------------------------------------------------------
model GeneratedContract {
  id                String   @id @default(uuid())
  
  leadId            String?  
  lead              Lead?    @relation(fields: [leadId], references: [id])
  
  propertyId        String?
  property          Property? @relation(fields: [propertyId], references: [id])
  
  templateId        String
  template          ContractTemplate @relation(fields: [templateId], references: [id])
  
  nomeDocumento     String
  conteudoFinalHtml String   @db.Text
  pdfUrl            String?
  status            String   @default("GERADO") // GERADO, ASSINADO, CANCELADO
  
  // Assinatura Eletronica
  signUrl           String?
  statusAssinatura  String?
  signedAt          DateTime?

  // Relacionamentos para assinaturas avançadas
  signers           ContractSigner[]
  histories         SignatureHistory[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContractSigner {
  id                   String            @id @default(uuid())
  generatedContractId  String
  generatedContract    GeneratedContract @relation(fields: [generatedContractId], references: [id], onDelete: Cascade)
  
  name                 String
  email                String
  phone                String?
  cpf                  String
  role                 String            // Locador, Locatário, Fiador, Testemunha, etc.
  status               String            @default("PENDENTE") // PENDENTE, ASSINADO, REJEITADO
  
  // Detalhes da assinatura (ICP-Brasil / Eletrônica)
  signedAt             DateTime?
  ipAddress            String?
  certificateDetails   String?           // Detalhes do Certificado ICP-Brasil (Ex: Emissor, Validade, etc.)
  
  // Links de assinatura individuais
  signUrl              String?           // Link individual para assinar
  
  // Posicionamento manual da assinatura
  coordsJson           String?           // JSON contendo posicionamento [{ page: 1, x: 100, y: 150, type: 'signature'|'rubrica' }]
  
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model SignatureHistory {
  id                   String            @id @default(uuid())
  generatedContractId  String
  generatedContract    GeneratedContract @relation(fields: [generatedContractId], references: [id], onDelete: Cascade)
  
  event                String            // ENVIO, ABERTURA, ASSINATURA, REENVIO, CANCELAMENTO
  description          String
  signerName           String?
  signerEmail          String?
  ipAddress            String?
  userAgent            String?
  
  createdAt            DateTime          @default(now())
}

